{
  "name": "pipeline-ci-cd",
  "version": "1.3.0",
  "private": true,
  "description": "Mock credit analysis API with an immutable Docker Hub deployment pipeline",
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/bootstrap/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/bootstrap/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run check:dependencies && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify:workflows": "node scripts/verify-workflows.mjs"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jose": "^6.2.16",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
